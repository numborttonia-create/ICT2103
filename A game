<!DOCTYPE html>
<html>
<head>
    <title>block puzzle wood blast</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h2>block puzzle wood blast</h2>
    <p>Guess a number between 1 and 10</p>

    <input type="number" id="guess" placeholder="Enter number">

    <button onclick="checkGuess()">Check</button>
    <button onclick="restart()">Restart</button>
    
    <p id="result"></p>

    <script src="script.js"></script>
</body>
</html>

body {
    text-align: center;
    font-family: Arial;
    padding: 50px;
}

input, button {
    padding: 10px;
    margin: 5px;
}
input, :start{
    size: 21px;
    left: 21px;
}

button {
    background: green;
    color: white;
    border: none;
    cursor: pointer;
}

let answer = Math.floor(Math.random() * 10) + 1;

function checkGuess() {
    let guess = Number(document.getElementById("guess").value);

    if (guess === answer) {
        document.getElementById("result").innerHTML = "Congratulations! You won!";
    } 
    else if (guess < 1 || guess > 10) {
        document.getElementById("result").innerHTML = "Enter a number from 1 to 10.";
    }
    else {
        document.getElementById("result").innerHTML = "Wrong number! Try again.";
    }
}

function restart() {
    answer = Math.floor(Math.random() * 10) + 1;
    document.getElementById("guess").value = "";
    document.getElementById("result").innerHTML = "Game restarted. Try again!";
}
